+/// The two hosts a picture is redirected to (T3223), each mapped to a folder
+/// with `SetVirtualHostNameToFolderMapping` so the BROWSER process reads the
+/// file from disk. A body handed back through `WebResourceRequested` is copied
+/// several times over inside this process on its way out — a 48 MB picture
+/// cost +459 MB of private bytes and a ~110 ms stall of the GUI thread — and a
+/// folder mapping is the one way to serve bytes the runtime offers that never
+/// cross this process at all.
+///
+/// `image_folder_host` maps the folder of the picture on screen (the
+/// `browser` route: the file is already something Chromium can draw);
+/// `decoded_folder_host` maps the pane's own scratch folder, where the `wic`
+/// route's worker writes the `.bmp` it decoded.
+pub const image_folder_host = "image.ghoztty.example";
+pub const decoded_folder_host = "decoded.ghoztty.example";
+
+/// `https://<host>/<name>?v=<revision>`, with `name` percent-encoded as one
+/// path segment. Everything outside RFC 3986's unreserved set is escaped,
+/// which is stricter than it needs to be and is the point: a file name may
+/// hold `#`, `?`, `%`, spaces or non-ASCII, and each of those means something
+/// else in a URL. The revision does the same job as on `imageUrl`: the
+/// `<img>` only goes back to the network for a `src` it does not already have.
+/// Caller owns the result.
+pub fn mappedImageUrl(alloc: Allocator, host: []const u8, name: []const u8, revision: u64) Allocator.Error![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(alloc);
+    try out.appendSlice(alloc, "https://");
+    try out.appendSlice(alloc, host);
+    try out.append(alloc, '/');
+    for (name) |c| {
+        const unreserved = std.ascii.isAlphanumeric(c) or c == '-' or c == '.' or c == '_' or c == '~';
+        if (unreserved) {
+            try out.append(alloc, c);
+        } else {
+            try out.print(alloc, "%{X:0>2}", .{c});
+        }
+    }
+    try out.print(alloc, "?v={d}", .{revision});
+    return out.toOwnedSlice(alloc);
+}
