+
+/// `SetVirtualHostNameToFolderMapping(host, dir)`, `deny_cors`: the viewer
+/// page may embed the folder's files but not read them. False on a runtime
+/// without `ICoreWebView2_3`, or when the runtime refuses.
+fn mapFolder(self: *ViewerPane, alloc: Allocator, comptime host: []const u8, dir: []const u8) bool {
+    const c = self.controller orelse return false;
+    const web = c.coreWebView() orelse return false;
+    defer web.release();
+    const v3 = web.queryV3() orelse return false;
+    defer v3.release();
+    const dir_w = std.unicode.wtf8ToWtf16LeAllocZ(alloc, dir) catch return false;
+    defer alloc.free(dir_w);
+    const host_w = std.unicode.utf8ToUtf16LeStringLiteral(host);
+    if (!v3.mapHostToFolder(host_w, dir_w, .deny_cors)) {
+        log.warn("viewer folder mapping refused: {s} -> {s}", .{ host, dir });
+        return false;
+    }
+    return true;
