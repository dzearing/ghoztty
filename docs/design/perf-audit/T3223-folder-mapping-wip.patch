+/// Map `dir` to `content.image_folder_host` unless it already is (T3223).
+fn mapImageFolder(self: *ViewerPane, alloc: Allocator, dir: []const u8) bool {
+    if (self.image_mapped_dir) |d| {
+        if (std.mem.eql(u8, d, dir)) return true;
+    }
+    const owned = alloc.dupe(u8, dir) catch return false;
+    if (!self.mapFolder(alloc, content.image_folder_host, dir)) {
+        alloc.free(owned);
+        return false;
+    }
+    if (self.image_mapped_dir) |d| alloc.free(d);
+    self.image_mapped_dir = owned;
+    return true;
