+/// wider (T2592). `logical` <= 0 is no such width.
+pub fn logicalRect(window: Rect, logical: i32) Rect {
+    if (logical <= 0 or window.left + logical >= window.right) return window;
+    return .{ .left = window.left, .top = window.top, .right = window.left + logical, .bottom = window.bottom };
