+/// A live layout pass grows a terminal pane's window in steps of this many
+/// pixels, ahead of the pane (T2592).
+pub const live_bucket_px: i32 = 256;
+
+/// How far ahead of the pane's visible width its window is kept.
+pub const live_headroom_px: i32 = 128;
+
+/// The width a live layout pass gives the window of a terminal pane that
+/// shows `logical` px of it, when the window is `current` px wide now
+/// (T2592). A window whose size changes shows its old picture with black
+/// beyond it until its present at the new size is composed, and on a big
+/// window that is a frame or two after the swap. So while a drag runs the
+/// window is kept wider than what shows, cut to `logical` by its region,
+/// and only ever grows - while the pane is still `live_headroom_px` short
+/// of its edge, so what any grow uncovers is outside the cut. Inside the
+/// window the pane grows by its region alone: the pixels it uncovers are
+/// the background the last frame already drew there. Never shrinks: a pane
+/// that narrows keeps its window, and the settle pass sizes it exactly.
+pub fn liveWindowWidth(logical: i32, current: i32) i32 {
+    if (logical <= 0) return logical;
+    if (current >= logical + live_headroom_px) return current;
+    const need = logical + live_headroom_px;
+    return @divFloor(need + live_bucket_px - 1, live_bucket_px) * live_bucket_px;
