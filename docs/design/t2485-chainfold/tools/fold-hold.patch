@@ -71,6 +71,21 @@ pub fn stretchedGlideMs(slide_ms: f64) f64 {
     return @max(slide_ms, 0) * glide_ms / 380;
 }
 
+/// The longest a glide holds still for a folding pane's last frame (T2485).
+/// A fold's card is that frame; until it is read back the pane is still live,
+/// and stepping the run over it showed the pane cut by its neighbour for a
+/// frame, then its card a long step on. The read-back takes a tick or two; a
+/// frame that never comes lets the glide go on without it after this long.
+pub const fold_frame_wait_ms: f64 = 100;
+
+/// The time a glide step counts while a fold waits for its frame (T2485):
+/// none, until the wait has run `fold_frame_wait_ms`, so the run and the
+/// folding card start moving on the same tick its card lands.
+pub fn foldWaitDt(dt_ms: f64, fold_waiting: bool, waited_ms: f64) f64 {
+    if (fold_waiting and waited_ms < fold_frame_wait_ms) return 0;
+    return dt_ms;
+}
+
 /// The fraction of the way to its target an edge goes in `dt_ms`, for a glide
 /// of time constant `tau_ms`. No time constant is no glide: all the way.
 pub fn followK(dt_ms: f64, tau_ms: f64) f64 {
@@ -1724,3 +1739,28 @@ test "leadingLag: the grid's leading edge as drawn, against where the layout put
     const none: Slide = .{};
     try testing.expectEqual(@as(?i32, null), none.leadingLag());
 }
+
+test "foldWaitDt: the glide holds still while a fold waits for its frame, then goes on (T2485)" {
+    // The run's card and the folding card, as the fold starts.
+    const before = [_]Placed{
+        .{ .id = 3, .rect = r(335, 0, 295, 600), .tucked = false },
+        .{ .id = 4, .rect = r(630, 0, 295, 600), .tucked = false },
+    };
+    const after = [_]Placed{
+        .{ .id = 3, .rect = r(576, 0, 295, 600), .tucked = false },
+        .{ .id = 4, .rect = r(870, 0, 295, 600), .tucked = true, .strip = r(870, 0, 45, 600) },
+    };
+    var s = plan(&before, &after, null, glide_ms, true);
+    try testing.expect(s.folding(4));
+    // Waiting for the frame: a 46 ms tick moves nobody - the run does not
+    // step over a pane that is still live.
+    try testing.expect(!s.step(foldWaitDt(46, true, 30)));
+    try testing.expectEqual(@as(i32, 335), s.placed(3).?.left);
+    try testing.expectEqual(@as(i32, 630), s.placed(4).?.left);
+    // The frame landed: the same tick moves the run and the card together.
+    _ = s.step(foldWaitDt(16, false, 30));
+    try testing.expect(s.placed(3).?.left > 335);
+    // A frame that never comes holds the glide no longer than the bound.
+    try testing.expectEqual(@as(f64, 16), foldWaitDt(16, true, fold_frame_wait_ms));
+    try testing.expectEqual(@as(f64, 0), foldWaitDt(16, true, fold_frame_wait_ms - 1));
+}
