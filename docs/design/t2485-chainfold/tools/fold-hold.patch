+/// Whether a card of the active tab is folding and its pane's last frame
+/// (T2457) has not been read back yet: the pane is still live under it.
+fn foldAwaitingFrame(self: *Window) bool {
+    if (self.tab_count == 0) return false;
+    var it = self.tab_trees[self.active_tab].iterator();
+    while (it.next()) |entry| {
+        if (entry.view.glide_snap == .waiting and !entry.view.glide_unfold) return true;
+    }
+    return false;
+}
