#!/bin/sh
# ghoztty pre-commit: refuse a commit while ANOTHER session holds the commit
# lock (tracker T948).
#
# Two Claude windows routinely share ONE working tree here (go.md step 0: an
# unmarked window filing tasks or auditing is never a rival and is never
# closed). One working tree means ONE index. On 2026-08-17 the second window
# ran a `-A` commit in the gap between the go-loop window's `git add` and its
# `git commit`, and git committed the index - which by then held both sets of
# changes. The loop's whole clipboard fix landed inside a commit whose subject
# described none of it, and it was pushed before anyone noticed.
#
# The lock is advisory and is held only across a stage->commit window (seconds)
# by scripts\git-commit-guard.ps1. The holder's own git children carry
# GHOZTTY_COMMIT_LOCK_KEY and pass straight through; every other session is
# refused - loudly, with the remedy in the message - so the collision arrives
# the way `.git/index.lock` already arrives for the instant of the write:
# visibly, instead of as a silent theft.
#
# A lock older than its ttl is stale and is REMOVED rather than obeyed, so a
# holder that crashed mid-commit can never wedge the repo for the next window.
#
# Installed per clone by `scripts\git-commit-guard.ps1 install` (core.hooksPath),
# which go-loop-exec.ps1's claim runs every turn.

git_dir="${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}"
[ -n "$git_dir" ] || exit 0

# T1231: refuse a commit that would write a control character into a text file.
# `zig-out\bin` arriving as `zig-out<0x08>in` is invisible to a reader and a
# path that cannot exist to a script; fifteen files were in that state before
# anyone noticed, one of them a guard's own coverage table. The loop's
# `parity-tasks.ps1 validate` asks the same question, but the OTHER window
# sharing this working tree never runs it - the hook is what covers everybody.
# Staged files only, so it costs nothing on a small commit; skipped silently if
# powershell is not on PATH, since this hook must never be the reason a commit
# cannot be made.
top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$top" ] && [ -f "$top/scripts/control-char-scan.ps1" ] && command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass \
        -File "$top/scripts/control-char-scan.ps1" -Staged -Repo "$top" -Quiet >&2
    # Only 1 means "found one". 2 means the scan could not run at all, and a
    # check that cannot answer must not be the thing that stops a commit.
    if [ "$?" -eq 1 ]; then
        echo "" >&2
        echo "COMMIT REFUSED - a staged file holds a control character (T1231)." >&2
        echo "Fix the line above, then commit again." >&2
        exit 1
    fi
fi

lock="$git_dir/ghoztty-commit.lock"

field() { sed -n "s/^$1=//p" "$lock" | head -n 1 | tr -d '\r'; }

# T1072: refuse a SECOND unpushed commit made around the guard. The guard's own
# commit pushes (T1057), and claim/validate catch unpushed work at the turn
# boundary - but a bare `git commit` from either window skipped all of that, so
# its work sat on this box for up to a whole turn. The post-commit hook warns on
# the first one; this refuses the next while the first is still local, which is
# the point where "I'll push in a minute" has stopped being true. A commit made
# BY the guard (its key matches the held lock) is exempt: the guard pushes on
# its own and a no-network push failure must not wedge its next commit.
# Skipped on a detached HEAD (a rebase in progress), on a branch with no
# upstream (nowhere to push yet), and while concluding a merge (the merge IS
# the integration step a push follows). GHOZTTY_ALLOW_UNPUSHED=1 is the hatch -
# an amend of the unpushed commit needs it - and it says it was taken.
guard_commit=0
if [ -n "$GHOZTTY_COMMIT_LOCK_KEY" ] && [ -f "$lock" ] && [ "$GHOZTTY_COMMIT_LOCK_KEY" = "$(field key)" ]; then
    guard_commit=1
fi
if [ "$guard_commit" -eq 0 ] && [ ! -f "$git_dir/MERGE_HEAD" ] &&
    branch=$(git symbolic-ref -q --short HEAD 2>/dev/null) &&
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null)
    if [ -n "$ahead" ] && [ "$ahead" -gt 0 ]; then
        if [ "$GHOZTTY_ALLOW_UNPUSHED" = "1" ]; then
            echo "ghoztty commit guard: UNPUSHED CHECK SKIPPED (GHOZTTY_ALLOW_UNPUSHED=1) - $branch is $ahead ahead of $upstream" >&2
        else
            echo "" >&2
            echo "COMMIT REFUSED - $branch is already $ahead commit(s) ahead of $upstream (T1072)." >&2
            echo "" >&2
            git log --oneline -n 5 '@{u}..HEAD' 2>/dev/null | sed 's/^/  /' >&2
            echo "" >&2
            echo "Every commit is pushed before the next one is made (go.md step 4): an" >&2
            echo "unpushed commit is invisible to the other seat and dies with this box." >&2
            echo "Push what is there, then commit again:" >&2
            echo "" >&2
            echo "  powershell -NoProfile -File scripts\\git-commit-guard.ps1 push" >&2
            echo "" >&2
            echo "Amending that unpushed commit, or no network at all? Say so:" >&2
            echo "  GHOZTTY_ALLOW_UNPUSHED=1 git commit ..." >&2
            echo "" >&2
            exit 1
        fi
    fi
fi

[ -f "$lock" ] || exit 0

key=$(field key)
holder=$(field holder)
epoch=$(field epoch)
ttl=$(field ttl)
[ -n "$ttl" ] || ttl=900

now=$(date +%s 2>/dev/null)
[ -n "$now" ] || now=0

if [ -n "$epoch" ] && [ "$now" -gt 0 ]; then
    age=$((now - epoch))
    if [ "$age" -lt 0 ] || [ "$age" -gt "$ttl" ]; then
        rm -f "$lock"
        echo "ghoztty commit guard: cleared a stale commit lock (${age}s old, ttl ${ttl}s)" >&2
        exit 0
    fi
else
    age="?"
fi

if [ -n "$GHOZTTY_COMMIT_LOCK_KEY" ] && [ "$GHOZTTY_COMMIT_LOCK_KEY" = "$key" ]; then
    exit 0
fi

echo "" >&2
echo "COMMIT REFUSED - another session in this working tree is composing a commit." >&2
echo "" >&2
echo "  holder : ${holder:-unknown}" >&2
echo "  held   : ${age}s (ttl ${ttl}s)" >&2
echo "" >&2
echo "You share one index with that session, so committing now would take its" >&2
echo "staged work into YOUR commit (T948). Wait a few seconds and retry - the" >&2
echo "hold lasts for one stage-then-commit, not a whole turn." >&2
echo "" >&2
echo "  powershell -NoProfile -File scripts\\git-commit-guard.ps1 status" >&2
echo "  powershell -NoProfile -File scripts\\git-commit-guard.ps1 release -Force   # holder is gone" >&2
echo "" >&2
exit 1
