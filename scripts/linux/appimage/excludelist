# Libraries package-appimage.sh never bundles (T3658): the host's own copy is
# the right one, because it is matched to the host's kernel, GPU driver or
# configuration files, or because two copies in one process break. One soname
# per line, as ldd prints it; '#' starts a comment. Modeled on the AppImage
# project's excludelist (github.com/AppImageCommunity/pkg2appimage).

# glibc. The AppImage therefore needs a glibc at least as new as the build
# distro's (Ubuntu 24.04: 2.39).
ld-linux-x86-64.so.2
libc.so.6
libm.so.6
libmvec.so.1
libdl.so.2
libpthread.so.0
librt.so.1
libresolv.so.2
libutil.so.1
libanl.so.1
libnsl.so.1
libBrokenLocale.so.1

# The compiler runtime: Mesa's drivers (C++, LLVM) are loaded from the host
# into this process and need the host's libstdc++, which is never older than
# what its own libraries were built with.
libstdc++.so.6
libgcc_s.so.1

# The GL / EGL / DRM stack: libglvnd dispatches to the host's driver.
libGL.so.1
libGLX.so.0
libGLdispatch.so.0
libOpenGL.so.0
libEGL.so.1
libGLESv2.so.2
libgbm.so.1
libdrm.so.2
libdrm_amdgpu.so.1
libdrm_intel.so.1
libdrm_nouveau.so.2
libdrm_radeon.so.1
libvulkan.so.1

# Display protocols: the host's libEGL links the host's copies, and one
# process can hold only one of each.
libwayland-client.so.0
libwayland-cursor.so.0
libwayland-egl.so.1
libwayland-server.so.0
libX11.so.6
libX11-xcb.so.1
libxcb.so.1
libxcb-dri2.so.0
libxcb-dri3.so.0
libxcb-glx.so.0
libxcb-present.so.0
libxcb-randr.so.0
libxcb-render.so.0
libxcb-shm.so.0
libxcb-sync.so.1
libxcb-xfixes.so.0
libxshmfence.so.1

# Fonts: fontconfig reads the host's /etc/fonts, whose format follows the
# host's fontconfig; freetype and harfbuzz go with it.
libfontconfig.so.1
libfreetype.so.6
libharfbuzz.so.0

# Audio and device plumbing that talks to host daemons or reads host config.
libasound.so.2
libudev.so.1
libdbus-1.so.3
